{
  "uid": "radar-bot",
  "title": "Radar · Bot de Telegram",
  "description": "Cuánta gente usa el bot «Sigue tu tren», qué sigue y qué hace, en conjunto: sin el número de ningún chat.",
  "tags": [
    "radar"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "entorno",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(radar_info, entorno)",
          "refId": "v"
        },
        "definition": "label_values(radar_info, entorno)",
        "refresh": 2,
        "current": {
          "text": "produccion",
          "value": "produccion"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Cuánta gente",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Personas",
      "description": "Chats que siguen algo ahora. El bot sólo atiende chats privados: cada chat es una persona. Quien escribe sin llegar a seguir nada no se guarda, así que no cuenta.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(radar_bot_chats{entorno=\"$entorno\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Cosas seguidas",
      "description": "Todo lo que siguen, sumando: algo que siguen tres personas cuenta tres.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (kind) (radar_bot_follows{entorno=\"$entorno\"}))",
