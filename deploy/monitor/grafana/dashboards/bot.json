    {
      "type": "timeseries",
      "title": "Altas y bajas por día",
      "description": "Personas que empiezan a seguir algo y que lo dejan, cada día (días contados en hora UTC). El día de hoy, que aún no ha acabado, está arriba en «Altas (24 h)» y «Bajas (24 h)». El primer día cuenta como altas a quienes ya seguían algo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(max(radar_bot_chats_added_total{entorno=\"$entorno\"}) - (max(radar_bot_chats_added_total{entorno=\"$entorno\"} offset 1d) or vector(0)), 0)",
          "refId": "P",
          "legendFormat": "Altas",
          "interval": "1d"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(max by (reason) (radar_bot_chats_removed_total{entorno=\"$entorno\"}) - (max by (reason) (radar_bot_chats_removed_total{entorno=\"$entorno\"} offset 1d) or max by (reason) (radar_bot_chats_removed_total{entorno=\"$entorno\"}) * 0), 0)",
          "refId": "Q",
          "legendFormat": "{{reason}}",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            },
            "drawStyle": "bars",
            "barAlignment": -1
          },
          "noValue": "Aún no ha acabado ningún día desde que se cuenta: cada barra es un día cerrado en hora UTC (acaba a la 01:00 peninsular en invierno)"
        },
        "overrides": [
