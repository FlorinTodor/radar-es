    {
      "type": "timeseries",
      "title": "CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"vps\",mode=\"idle\"}[5m]))",
          "refId": "K",
          "legendFormat": "uso"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(rate(node_cpu_seconds_total{job=\"vps\",mode=\"iowait\"}[5m]))",
          "refId": "L",
          "legendFormat": "esperando al disco"
