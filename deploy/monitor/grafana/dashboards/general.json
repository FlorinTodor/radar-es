      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Respuestas por tipo",
      "description": "2xx bien; 3xx copias y redirecciones; 4xx lo que no existe; 5xx errores (503: presupuestos o actualizando).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (clase) (label_replace(rate(radar_http_requests_total{entorno=\"$entorno\"}[5m]), \"clase\", \"${1}xx\", \"status\", \"(\\\\d).*\"))",
          "refId": "H",
          "legendFormat": "{{clase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
