{
  "uid": "radar-general",
  "title": "Radar · General",
  "description": "Lo esencial: si la web, la API y el MCP responden, y cómo van el tráfico, la memoria y las fuentes.",
  "tags": [
    "radar"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
