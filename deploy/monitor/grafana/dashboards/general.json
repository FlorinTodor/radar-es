  "templating": {
    "list": [
      {
        "name": "entorno",
        "label": "Entorno",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(radar_info, entorno)",
          "refId": "v"
        },
        "definition": "label_values(radar_info, entorno)",
        "refresh": 2,
        "current": {
          "text": "produccion",
          "value": "produccion"
        },
        "includeAll": false,
        "multi": false
      }
    ]
