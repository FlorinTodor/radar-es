# /opt/radar-monitor/.env: sólo en el VPS (permisos 600), nunca en git. Ver deploy/preparar-monitor.sh.
# Bot de Telegram de las alertas (@BotFather) y el chat al que escribe (getUpdates tras mandarle /start).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Access: el equipo (lo que va antes de .cloudflareaccess.com) y la etiqueta AUD de la
# aplicación de monitor.radarespaña.es. Grafana sólo deja entrar con una firma suya que los lleve.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# La crea preparar-monitor.sh si falta.
GRAFANA_ADMIN_PASSWORD=
