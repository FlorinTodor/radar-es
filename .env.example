# Copia este fichero a .env. De las 53 fuentes, 27 funcionan sin clave, 25 necesitan NAP_API_KEY,
# la clave gratuita del Punto de Acceso Nacional (nap.transportes.gob.es): trazados de líneas,
# estaciones de otras redes y posiciones estimadas por horario (Ouigo, ALSA, autobuses, metros y
# tranvías), y 1 ESIOS_TOKEN (más abajo).
# NAP_API_KEY=
# Avisos de servicio de EMT Madrid: si están, se leen con la aplicación registrada en MobilityLabs
# (mobilitylabs.emtmadrid.es → Portal Desarrolladores → Aplicaciones); si no, sin ella.
# EMT_MADRID_CLIENT_ID=
# EMT_MADRID_PASSKEY=
PORT=8080
# 127.0.0.1 = sólo este equipo. 0.0.0.0 = accesible desde la red local.
HOST=127.0.0.1
# Hilos para leer los horarios GTFS, los trazados y el XML de la DGT. Vacío o 0 = todo en el hilo
# principal (por defecto). 2 = un hilo por CPU del contenedor: arranque ~20 % más rápido, pero cada
# hilo carga sus horarios y el pico de memoria sube; vigilar docker stats al arrancar y a medianoche.
# WORKER_THREADS=2

# Aviso legal y User-Agent (recomendado al publicar): titular de la web y email de contacto.
# OWNER_NAME=
# CONTACT_EMAIL=
# PUBLIC_URL=https://xn--radarespaa-19a.es
# Contador de visitas sin cookies (goatcounter.com). Vacío = no se cuenta nada.
# GOATCOUNTER_URL=https://CODIGO.goatcounter.com/count

# Red Eléctrica e·sios: demanda de cada isla de Canarias, Ceuta y Melilla para avisar de un apagón total.
# Token personal gratuito que se pide desde www.esios.ree.es; uso no comercial. Sin él, esa fuente se desactiva.
# ESIOS_TOKEN=

# Claves gratuitas para fuentes futuras (una fuente que declare `requires` se activa sola al rellenarlas):
# AEMET_API_KEY=        # AEMET OpenData: avisos con polígonos, observaciones
# TMB_APP_ID=           # Metro y bus de Barcelona (developer.tmb.cat)
# TMB_APP_KEY=
# FIRMS_MAP_KEY=        # NASA FIRMS: focos de incendio por satélite
