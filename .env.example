# Copia este fichero a .env. Todas las fuentes actuales funcionan sin clave.
PORT=8080
# 127.0.0.1 = sólo este equipo. 0.0.0.0 = accesible desde la red local.
HOST=127.0.0.1

# Claves gratuitas para fuentes futuras (una fuente que declare `requires` se activa sola al rellenarlas):
# NAP_API_KEY=          # Punto de Acceso Nacional de transporte (nap.transportes.gob.es)
# AEMET_API_KEY=        # AEMET OpenData: avisos con polígonos, observaciones
# TMB_APP_ID=           # Metro y bus de Barcelona (developer.tmb.cat)
# TMB_APP_KEY=
# EMT_MADRID_CLIENT_ID= # EMT Madrid MobilityLabs
# EMT_MADRID_PASSKEY=
# FIRMS_MAP_KEY=        # NASA FIRMS: focos de incendio por satélite
